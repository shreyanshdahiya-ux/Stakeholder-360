<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Days_Since_Last_Engagement__c</fullName>
    <deprecated>false</deprecated>
    <description>Number of days since last engagement with this stakeholder</description>
    <externalId>false</externalId>
    <formula>IF(ISBLANK(Last_Engagement_Date__c), 999, TODAY() - Last_Engagement_Date__c)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Days Since Last Engagement</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
