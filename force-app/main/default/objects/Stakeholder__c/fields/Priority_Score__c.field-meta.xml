<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Priority_Score__c</fullName>
    <deprecated>false</deprecated>
    <description>Auto-calculated priority score based on Influence + Decision Power + Engagement</description>
    <externalId>false</externalId>
    <formula>(
    CASE(TEXT(Influence_Level__c), &quot;High&quot;, 3, &quot;Medium&quot;, 2, &quot;Low&quot;, 1, 0) +
    CASE(TEXT(Decision_Power__c), &quot;High&quot;, 3, &quot;Medium&quot;, 2, &quot;Low&quot;, 1, 0) +
    CASE(TEXT(Engagement_Level__c), &quot;Hot&quot;, 3, &quot;Warm&quot;, 2, &quot;Cold&quot;, 1, 0)
) -
IF(ISPICKVAL(Sentiment__c, &quot;Negative&quot;), 2, 0)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Priority Score</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
